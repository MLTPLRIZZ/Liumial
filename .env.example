# Server Config
NODE_ENV=production
PORT=3000
HOST=0.0.0.0

# Database
DB_PATH=./data/liumial.db

# JWT
JWT_SECRET=your_super_secret_jwt_key_here_change_in_production
JWT_EXPIRY=7d

# CORS
CLIENT_URL=http://localhost:5173

# Features
ENABLE_REGISTRATION=true
ENABLE_QUESTS=true
QUEST_CHECK_INTERVAL=60000
